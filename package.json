{
  "name": "root",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "lerna run --parallel dev",
    "build": "lerna run --stream build",
    "clean": "lerna run clean",
    "typescript": "lerna run --stream typescript",
    "test": "lerna run --stream test",
    "test:changed": "lerna run --stream --since HEAD test",
    "lint": "lerna run --stream lint",
    "format": "prettier --check \"**/*.{js,jsx,mjs,ts,tsx,json,md}\"",
    "format:fix": "prettier --write \"**/*.{js,jsx,mjs,ts,tsx,json,md}\"",
    "typedoc": "lerna run typedoc",
    "serve-log4brains": "serve .log4brains/out",
    "link-cli": "lerna run --stream link",
    "unlink-cli": "lerna run --stream unlink",
    "e2e": "cd e2e-tests && npm ci --no-audit --no-fund && node e2e-launcher.js",
    "lerna": "lerna",
    "release": "./scripts/release.sh",
    "prepare": "node .husky/install.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/rimraf": "^3.0.0",
    "cross-env": "^7.0.3",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.17.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-mock-extended": "^4.0.2",
    "lerna": "^10.1.1",
    "lint-staged": "^17.6.1",
    "nodemon": "^2.0.6",
    "prettier": "^3.10.1",
    "rimraf": "^3.0.2",
    "serve": "^11.3.2",
    "ts-jest": "^29.4.15",
    "tsup": "^9.0.0",
    "typedoc": "0.17.0-3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --max-warnings=0 --no-warn-ignored",
    "*.{js,jsx,mjs,ts,tsx,json,md}": "prettier --check"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
