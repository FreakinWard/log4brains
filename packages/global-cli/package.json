{
  "name": "@awarded/log4brains",
  "version": "1.1.0",
  "description": "Log and publish your architecture decisions (ADR) with Log4brains",
  "keywords": [
    "log4brains",
    "architecture decision records",
    "adr",
    "architecture",
    "knowledge base",
    "documentation",
    "docs-as-code",
    "markdown",
    "static site generator",
    "documentation generator",
    "tooling"
  ],
  "author": "Thomas Vaillant <thomvaill@bluebricks.dev>",
  "license": "Apache-2.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/FreakinWard/log4brains",
  "repository": {
    "type": "git",
    "url": "https://github.com/FreakinWard/log4brains",
    "directory": "packages/global-cli"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "files": [
    "dist"
  ],
  "source": "./src/index.ts",
  "main": "./dist/index.js",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "log4brains": "./dist/log4brains"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup && copyfiles -u 1 src/log4brains dist",
    "clean": "rimraf ./dist",
    "typescript": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "prepublishOnly": "cp ../../README.md . && npm run build",
    "link": "npm link",
    "unlink": "npm unlink"
  },
  "dependencies": {
    "@awarded/log4brains-cli": "1.1.0",
    "@awarded/log4brains-cli-common": "1.1.0",
    "@awarded/log4brains-core": "1.1.0",
    "@awarded/log4brains-init": "1.1.0",
    "@awarded/log4brains-web": "1.1.0",
    "chalk": "^6.0.1",
    "commander": "^15.1.0"
  },
  "devDependencies": {
    "copyfiles": "^2.4.0"
  }
}
