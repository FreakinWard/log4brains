{
  "name": "@freakin-ward/log4brains-core",
  "version": "1.1.0",
  "description": "Log4brains architecture knowledge base core API",
  "keywords": [
    "log4brains"
  ],
  "author": "Thomas Vaillant <thomvaill@bluebricks.dev>",
  "license": "Apache-2.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/FreakinWard/log4brains",
  "repository": {
    "type": "git",
    "url": "https://github.com/FreakinWard/log4brains",
    "directory": "packages/core"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "files": [
    "dist"
  ],
  "source": "./src/index.ts",
  "main": "./dist/index.js",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "clean": "rimraf ./dist",
    "typescript": "tsc --noEmit",
    "test": "jest",
    "lint": "eslint . --max-warnings=0",
    "typedoc": "typedoc --tsconfig tsconfig.build.json --includeVersion --readme none --excludePrivate --out docs/typedoc src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "awilix": "^13.0.7",
    "cheerio": "^1.2.0",
    "chokidar": "^6.0.0",
    "domhandler": "^5.0.3",
    "git-url-parse": "^16.1.0",
    "joi": "^18.3.2",
    "launch-editor": "^2.14.2",
    "lodash": "^4.18.1",
    "markdown-it": "^15.0.3",
    "moment": "^2.31.0",
    "moment-timezone": "^0.6.6",
    "open": "^11.0.4",
    "simple-git": "^4.1.0",
    "slugify": "^1.6.9",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.27",
    "globby": "^16.2.4"
  }
}
