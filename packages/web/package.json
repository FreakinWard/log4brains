{
  "name": "@awarded/log4brains-web",
  "version": "1.1.0",
  "description": "Log4brains architecture knowledge base web UI and static site generator",
  "keywords": [
    "log4brains"
  ],
  "author": "Thomas Vaillant <thomvaill@bluebricks.dev>",
  "license": "Apache-2.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/FreakinWard/log4brains",
  "repository": {
    "type": "git",
    "url": "https://github.com/FreakinWard/log4brains",
    "directory": "packages/web"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "files": [
    "dist",
    "nextjs",
    "!nextjs/coverage",
    "!nextjs/storybook-static",
    "!nextjs/src/**/*.test.ts",
    "!nextjs/src/**/*.test.tsx",
    "!nextjs/src/**/*.stories.tsx",
    "!nextjs/src/**/__snapshots__"
  ],
  "source": "./index.ts",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "npm run dev:cli",
    "build": "npm run build:cli && npm run build:nextjs",
    "clean": "npm run clean:cli && npm run clean:nextjs",
    "dev:cli": "tsup --watch",
    "build:cli": "tsup",
    "clean:cli": "rimraf ./dist",
    "dev:nextjs": "cd nextjs && cross-env LOG4BRAINS_CWD=../.. next dev",
    "build:nextjs": "npm run clean:nextjs && cd nextjs && cross-env LOG4BRAINS_PHASE=initial-build next build --webpack",
    "clean:nextjs": "rimraf ./nextjs/.next ./nextjs/.next-export ./nextjs/.next-preview",
    "serve": "serve .log4brains/out",
    "typescript": "tsc --noEmit && cd nextjs && next typegen && tsc",
    "test": "jest --config nextjs/jest.config.js",
    "lint": "eslint . --max-warnings=0",
    "storybook": "cd nextjs && storybook dev -p 6006",
    "build-storybook": "cd nextjs && storybook build -o storybook-static",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@awarded/log4brains-cli-common": "1.1.0",
    "@awarded/log4brains-core": "1.1.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/lab": "^9.0.0-beta.10",
    "@mui/material": "^9.5.0",
    "@next/bundle-analyzer": "^16.4.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "badge-maker": "^6.0.0",
    "chalk": "^6.0.1",
    "commander": "^15.1.0",
    "copy-text-to-clipboard": "^3.2.2",
    "highlight.js": "^11.12.0",
    "lunr": "^2.3.9",
    "markdown-to-jsx": "^9.10.6",
    "moment": "^2.29.1",
    "next": "^16.4.6",
    "open": "^11.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "slugify": "^1.4.5",
    "socket.io": "^4.8.4",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@storybook/nextjs": "^10.6.8",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/lunr": "^2.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/signale": "^1.4.1",
    "@types/url-parse": "^1.4.3",
    "jest-environment-jsdom": "^30.5.2",
    "react-is": "^19.3.1",
    "socket.io-client": "^4.8.4",
    "storybook": "^10.6.8"
  }
}
